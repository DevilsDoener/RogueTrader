.git
.gitignore
.venv
.worktrees
.env
.pytest_cache
__pycache__
tmp
.superpowers
data
staticfiles
tests/visual
*.py[cod]
docs

# Foreign artefacts that must never ship in the image. Without these,
# collectstatic picked up 78 OneNote files and hashed them into staticfiles,
# and a local pytest temp directory was baked in.
**/*.onetoc2
graphify-out
pytest-of-*
pytest-cache-files-*
.claude
.planning

# Development-only: agent folders, calibration tools, host-side backup
# scripts, the browser tests and the dev dependency lock. Nothing the app
# imports or serves at runtime lives here.
.agents
.codex
.mcp.json
tools
scripts
tests
conftest.py
requirements-dev.*
backups
