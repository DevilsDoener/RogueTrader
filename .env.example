# SECURITY: this placeholder is rejected by config/settings.py whenever
# DJANGO_DEBUG=false. Generate a real value before deploying, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
# Explicit, comma-separated hostnames the proxy will forward as Host.
# Required (no default) whenever DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 127.0.0.1 when the reverse proxy runs on this same host/container.
# Set to this guest's private network address (e.g. 10.0.0.5) when the
# proxy lives in a different Proxmox guest and reaches this one over the
# internal network.
APP_BIND_ADDRESS=127.0.0.1
# Full public URL (with scheme) that end users reach the portal at. Used to
# derive CSRF_TRUSTED_ORIGINS, so it must match what the reverse proxy
# presents to browsers.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set to 1 once the reverse proxy is confirmed to serve HTTPS correctly.
# HSTS instructs browsers to refuse HTTP for a year, which is hard to
# undo, so leave this at 0 until TLS is verified end-to-end.
ENABLE_HSTS=0
# The chapter list and its reading order live in wiki/manifest.py. Set this
# only to override them, as a comma-separated list of filenames.
# WIKI_CONTENT_ALLOWLIST=
# Abort startup instead of serving an empty wiki when the content mount is
# wrong. compose.yaml switches this on for the container.
WIKI_STRICT_CONTENT=false
SHEET_SOURCE_PDF=/content/wiki/character-sheet.pdf
