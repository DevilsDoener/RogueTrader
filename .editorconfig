# https://editorconfig.org -- measured from the tracked files, not aspirational.
# Line endings are deliberately not set here: .gitattributes owns them.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,html,css,js}]
indent_size = 2

# Markdown: two trailing spaces are a hard line break; lists nest by 2.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Windows PowerShell 5.1 only reads non-ASCII text correctly with a BOM.
[scripts/offsite-backup.ps1]
charset = utf-8-bom

# pip-compile output (hash continuation lines): regenerated, not hand-edited.
[requirements*.txt]
indent_size = 4

[*.{webp,png,jpg,jpeg,pdf,ico,sqlite3,onetoc2}]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
